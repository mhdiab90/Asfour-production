# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Web Configuration for Project: asfourproduction-70e6e
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="asfourproduction-70e6e.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="asfourproduction-70e6e"
VITE_FIREBASE_STORAGE_BUCKET="asfourproduction-70e6e.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="490935502022"
VITE_FIREBASE_APP_ID="1:490935502022:web:0681053f2cd09ff5a2c3c7"

# AI Assistant provider selection - NOT a secret. "mock" (default) uses the
# local deterministic MockProvider. "claude" activates ClaudeProvider, which
# requires VITE_AI_GATEWAY_URL below to be set and actually deployed - see
# cloudflare/ai-gateway/README.md. Leave unset (defaults to "mock") until
# that gateway is live.
VITE_AI_PROVIDER="mock"

# Public URL of the deployed secure AI gateway (Cloudflare Worker) that
# holds the real ANTHROPIC_API_KEY server-side. This is just an endpoint
# address, safe to expose - never put ANTHROPIC_API_KEY itself here or
# anywhere with a VITE_ prefix, it would ship to every browser.
VITE_AI_GATEWAY_URL=""

# Non-secret hint of which Claude model the gateway is using, shown in the
# assistant UI. The gateway's own ANTHROPIC_MODEL var is the source of truth.
VITE_CLAUDE_MODEL=""

